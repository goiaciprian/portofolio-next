{
  "name": "@portofolio/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./styles.css": "./dist/index.css",
    "./*": "./dist/*.js"
  },
  "license": "MIT",
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@portofolio/eslint-config": "workspace:*",
    "@portofolio/tailwind-config": "workspace:*",
    "@portofolio/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4.3.1",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.4",
    "tailwindcss": "^4.3.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "lucide-react": "^0.553.0"
  }
}
